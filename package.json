{
  "name": "fedi-tap",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "svelte-check": "svelte-check --fail-on-warnings",
    "try": "node tools/scripts/try.js",
    "certs": "mkdir -p .local/dev-certs && mkcert -cert-file .local/dev-certs/localhost.pem -key-file .local/dev-certs/localhost-key.pem localhost 127.0.0.1 ::1",
    "dev:docker": "docker compose up --build",
    "check": "node tools/scripts/check.js",
    "lint": "biome lint .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "validate": "biome check . && npm run svelte-check && npm test && npm run build && npm run check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "svelte": "^5.58.0",
    "svelte-check": "^4.7.8",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
