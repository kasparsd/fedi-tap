{
  "name": "fedi-tap",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "try": "node tools/scripts/try.js",
    "dev": "node tools/scripts/dev.js",
    "certs": "mkdir -p .local/dev-certs && mkcert -cert-file .local/dev-certs/localhost.pem -key-file .local/dev-certs/localhost-key.pem localhost 127.0.0.1 ::1",
    "dev:docker": "docker compose up --build",
    "check": "node tools/scripts/check.js",
    "lint": "biome lint .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "validate": "biome check . && npm run check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8"
  }
}
