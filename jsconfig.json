{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "esnext",
    "lib": ["esnext", "dom", "dom.iterable"],
    "types": ["svelte"],
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*", "vite.config.js"]
}
