{
  "id": "./",
  "name": "⁂tap",
  "short_name": "⁂tap",
  "description": "Like, repost, reply to or follow a Fediverse post from your own account.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f2f2f7",
  "theme_color": "#f2f2f7",
  "categories": ["social", "utilities"],
