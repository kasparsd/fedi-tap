#define name ⁂tap
#define inputs text, url
#define from sharesheet
#define color lightblue
#define glyph asterisk

#include 'actions/text'
#include 'actions/web'

const page = "https://kasparsd.github.io/fedi-tap/"
const sharedText = getText(ShortcutInput)
const urls = getURLs(sharedText)
if urls {
    const sharedURL = getFirstItem(urls)
    const encoded = urlEncode("{sharedURL}")
    openURL("{page}?url={encoded}")
} else {
    openURL("{page}?via=shortcut")
}
